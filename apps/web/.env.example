# Server-side only. Never add NEXT_PUBLIC_ and never commit real values.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Local browser-chat testing only. This is ignored in production even if set.
LOCAL_AI_CHAT=false
# Explicit emergency fallback when the shared Core conversation service is unavailable.
# This keeps Dify chat usable but does not provide cross-device history or OrangePi sync.
STARBAO_CORE_OPTIONAL=false
# Optional server-side HTTP(S) proxy. Leave empty when direct access works.
AI_HTTP_PROXY=

# Required for AI routes on Vercel. Configure one complete pair.
# Preferred pair:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Compatible alternative pair:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional FastAPI Core API adapter. CORE_API_URL must be HTTPS on Vercel.
CORE_API_URL=
CORE_API_ADMIN_TOKEN=
CORE_DEVICE_ID=

# Local/self-hosted in-memory guard only. Leave false unless the proxy is trusted.
TRUST_PROXY_HEADERS=false
